---
import Base from '../layouts/Base.astro';
import { site } from '../utils';
const clients = ['Telkom Indonesia', 'Infranexia', 'Telkom AI', 'Leap', 'Votre Peau', 'Satunadi'];
---
<Base title="Info">
  <section class="info wrap">
    <h1 class="info-lead serif">
      <span class="line"><span>I make brands</span></span>
      <span class="line"><span>look like they</span></span>
      <span class="line"><span>mean it.</span></span>
    </h1>
    <div class="info-grid">
      <p class="info-bio" data-reveal>
        Visual designer based in {site.city}. Five years across agency and the Telkom ecosystem, working on key visuals, event identities, and brand systems. Ganti paragraf ini dengan bio final dari Wix.
      </p>
      <div data-reveal>
        <h2 class="small muted">Selected clients</h2>
        <ul class="info-list">{clients.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div data-reveal>
        <h2 class="small muted">Contact</h2>
        <ul class="info-list">
          <li><a class="link-line" href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.social.map((s) => <li><a class="link-line" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .info { padding-top: clamp(9rem, 20vw, 14rem); padding-bottom: clamp(6rem, 12vw, 10rem); }
  .info-lead { margin: 0; font-size: clamp(3rem, 9vw, 8.5rem); line-height: .95; letter-spacing: -.03em; }
  .info-grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 1.5rem; row-gap: 3rem; margin-top: clamp(5rem, 10vw, 8rem); }
  .info-bio { grid-column: 1 / 6; margin: 0; font-family: var(--serif); font-size: clamp(1.2rem, 1.8vw, 1.5rem); line-height: 1.5; max-width: 34ch; }
  .info-grid > div:nth-child(2) { grid-column: 7 / 10; }
  .info-grid > div:nth-child(3) { grid-column: 10 / 13; }
  .info-grid h2 { font-weight: 400; margin: 0 0 1rem; }
  .info-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
  @media (max-width: 768px) {
    .info-bio, .info-grid > div:nth-child(2), .info-grid > div:nth-child(3) { grid-column: 1 / -1; }
  }
</style>
